@using Dilcore.WebApp.Constants

<div class="agent-hub__input-bar">
    <MudTextField T="string"
                  Value="@Value"
                  ValueChanged="HandleValueChangedAsync"
                  Placeholder="@Placeholder"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  FullWidth="true"
                  Immediate="true"
                  Disabled="@(Disabled || IsStreaming)"
                  data-testid="@AgentConstants.TestIds.MessageInput"
                  OnKeyDown="@HandleKeyDownAsync"
                  Class="agent-hub__input" />
    <MudIconButton Icon="@Icons.Material.Filled.Send"
                   Color="Color.Primary"
                   data-testid="@AgentConstants.TestIds.SendButton"
                   Disabled="@(Disabled || IsStreaming || string.IsNullOrWhiteSpace(Value))"
                   OnClick="@SendAsync" />
</div>

<div class="agent-hub__footer">
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="agent-hub__footer-text">
        @AgentConstants.FooterDisclaimer
    </MudText>
</div>
