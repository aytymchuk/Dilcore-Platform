@using Dilcore.WebApp.Constants
@using Dilcore.WebApp.Models.Agent

@if (Message.Author == ChatAuthor.Status)
{
    <div class="agent-msg agent-msg--status" data-testid="@AgentConstants.TestIds.StreamingIndicator">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @Message.Content
        </MudText>
    </div>
}
else if (Message.Author == ChatAuthor.User)
{
    <div class="agent-msg agent-msg--user" data-testid="@AgentConstants.TestIds.UserBubble">
        <MudAvatar Size="Size.Small" Class="agent-msg__avatar">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
        </MudAvatar>
        <div class="agent-msg__body">
            <div class="agent-msg__meta">
                <MudText Typo="Typo.body2" Class="agent-msg__name">You</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatTime(Message.Timestamp)</MudText>
            </div>
            <MudPaper Class="agent-msg__user-card pa-3" Elevation="0" Outlined="true">
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Message.Content</MudText>
            </MudPaper>
        </div>
    </div>
}
else
{
    <div class="agent-msg agent-msg--assistant" data-testid="@AgentConstants.TestIds.AssistantBubble">
        <div class="agent-msg__assistant-avatar">
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="agent-msg__assistant-icon" />
        </div>
        <div class="agent-msg__body agent-msg__body--assistant">
            <div class="agent-msg__meta">
                <MudText Typo="Typo.body2" Color="Color.Primary" Class="agent-msg__name">Dilcore Agent</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatTime(Message.Timestamp)</MudText>
                @if (IsStreaming)
                {
                    <span class="agent-msg__streaming-dot" aria-hidden="true"></span>
                }
            </div>
            @if (ShowReasoningSection)
            {
                <MudExpansionPanels Elevation="0" Class="agent-msg__reasoning-panels">
                    <MudExpansionPanel @bind-Expanded="_reasoningExpanded"
                                       Text="@AgentConstants.ReasoningLabel"
                                       Class="agent-msg__reasoning-panel">
                        @if (_reasoningDisplay.IsStructured)
                        {
                            @if (!string.IsNullOrEmpty(_reasoningDisplay.Narrative))
                            {
                                <MudText Typo="Typo.body2" Class="agent-msg__reasoning-narrative">
                                    @_reasoningDisplay.Narrative
                                </MudText>
                            }
                            @if (!string.IsNullOrEmpty(_reasoningDisplay.NextRoute))
                            {
                                <div class="agent-msg__decision">
                                    <div class="agent-msg__decision-row">
                                        <MudText Typo="Typo.caption" Class="agent-msg__decision-caption">
                                            @AgentConstants.ReasoningDecisionLabel
                                        </MudText>
                                        <MudChip T="string"
                                                 Size="Size.Small"
                                                 Color="Color.Primary"
                                                 Variant="Variant.Filled"
                                                 Class="agent-msg__decision-chip">
                                            @_reasoningDisplay.NextRoute
                                        </MudChip>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="agent-msg__reasoning-fallback">@ReasoningDisplayText</MudText>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            <div class="agent-prose mud-typography-body2">
                <AgentMarkdown Value="@Message.Content" />
            </div>
        </div>
    </div>
}
