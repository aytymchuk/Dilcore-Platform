<MudPaper Class="schema-panel d-flex flex-column" Style="width: 320px; flex-shrink: 0;" Outlined="true" Elevation="0">
    <div class="d-flex align-center justify-space-between pa-4">
        <MudText Typo="Typo.caption" Class="font-weight-bold text-uppercase" Style="letter-spacing: 0.1em;">Generated Schema</MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Class="text-caption font-weight-bold">DRAFT</MudChip>
    </div>
    <div class="schema-file-header d-flex align-center justify-space-between px-4 py-2 border-b mud-border-lines-default">
        <MudText Typo="Typo.caption" Class="font-mono text-secondary">@FileName</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Color="Color.Inherit" OnClick="OnCopy" title="Copy schema" />
    </div>
    <div class="schema-preview flex-grow-1 overflow-auto pa-4">
        <pre class="schema-json ma-0">@Content</pre>
    </div>
</MudPaper>

@code {
    [Parameter]
    public string FileName { get; set; } = string.Empty;

    [Parameter]
    public string Content { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnCopy { get; set; }
}
