@page "/workspaces/{tenant}/admin/agent"
@page "/workspaces/{tenant}/admin/agent/{ThreadId}"
@attribute [Authorize]
@using Dilcore.WebApp.Components.Common
@using Dilcore.WebApp.Components.Layout
@using Dilcore.WebApp.Constants
@inherits TenantComponentBase
@layout AdminLayout

<PageTitle>@AgentConstants.PageTitle</PageTitle>

<div class="@GetRootClass()">
    @if (_isLoadingThreads)
    {
        <div class="agent-hub__layout">
            <ConversationListSkeleton />
            <div class="agent-hub__main">
                <div class="agent-hub__scroll agent-hub__scroll--landing">
                    <div class="agent-hub__content agent-hub__content--split">
                        <ChatHistorySkeleton />
                    </div>
                </div>
                <div class="agent-hub__input-dock">
                    <ChatMessageInput @bind-Value="_inputText"
                                      Placeholder="@AgentConstants.InputPlaceholder"
                                      Disabled="true"
                                      IsStreaming="false"
                                      OnSend="SendAsync" />
                </div>
            </div>
        </div>
    }
    else if (_summaries.Count > 0)
    {
        <div class="agent-hub__layout">
            <ConversationList Items="_summaries"
                              ActiveThreadId="@ThreadId"
                              OnSelect="SelectThreadAsync"
                              OnNewChat="NewChatAsync" />
            <div class="agent-hub__main">
                <div class="agent-hub__scroll @(ShowQuickActions ? "agent-hub__scroll--landing" : null)">
                    <div class="agent-hub__content agent-hub__content--split">
                        @if (_isLoadingMessages)
                        {
                            <ChatHistorySkeleton />
                        }
                        else if (ShowQuickActions)
                        {
                            <AgentQuickActionsPanel QuickActions="_quickActions"
                                                    OnActionSelected="OnQuickAction" />
                        }
                        else
                        {
                            <ChatHistory ThreadTitle="@CurrentThreadTitle"
                                         Messages="_messages"
                                         PendingAssistantMarkdown="@_pendingAssistant"
                                         PendingReasoning="@_pendingReasoning"
                                         IsStreaming="_isStreaming"
                                         Status="@_status" />
                        }
                    </div>
                </div>
                <div class="agent-hub__input-dock">
                    <ChatMessageInput @bind-Value="_inputText"
                                      Placeholder="@AgentConstants.InputPlaceholder"
                                      IsStreaming="_isStreaming"
                                      OnSend="SendAsync" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="agent-hub__scroll agent-hub__scroll--landing">
            <div class="agent-hub__content">
                <AgentQuickActionsPanel QuickActions="_quickActions"
                                        OnActionSelected="OnQuickAction" />
            </div>
        </div>
        <div class="agent-hub__input-dock">
            <ChatMessageInput @bind-Value="_inputText"
                              Placeholder="@AgentConstants.InputPlaceholder"
                              IsStreaming="_isStreaming"
                              OnSend="SendAsync" />
        </div>
    }
</div>
