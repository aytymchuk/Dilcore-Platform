@using Dilcore.WebApp.Constants

<AuthorizeView Context="auth">
    <Authorized>
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" LockScroll="true" PopoverClass="mt-2">
            <ActivatorContent Context="menu">
                @if (InSidebar)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               Class="text-transform-none pa-3 w-100"
                               Style="justify-content: flex-start; text-align: start;"
                               FullWidth="true"
                               OnClick="@menu.ToggleAsync">
                        <div class="d-flex align-center gap-3">
                            <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Small" Class="rounded-circle">
                                @(UserState?.CurrentUser?.FullName?.FirstOrDefault() ?? auth.User.Identity?.Name?.FirstOrDefault() ?? 'U')
                            </MudAvatar>
                            <div class="flex-grow-1 min-w-0">
                                <MudText Typo="Typo.body2" Class="font-weight-medium text-truncate">@(UserState?.CurrentUser?.FullName ?? auth.User.Identity?.Name ?? "User")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="text-truncate d-block">@Subtitle</MudText>
                            </div>
                        </div>
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               Class="pa-0 min-width-auto"
                               OnClick="@menu.ToggleAsync">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                            @(UserState?.CurrentUser?.FullName?.FirstOrDefault() ?? auth.User.Identity?.Name?.FirstOrDefault() ?? 'U')
                        </MudAvatar>
                    </MudButton>
                }
            </ActivatorContent>
            <ChildContent>
                <div class="px-4 py-3">
                    <MudText Typo="Typo.body2" Class="font-bold">@(UserState?.CurrentUser?.FullName ?? auth.User.Identity?.Name)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(UserState?.CurrentUser?.Email ?? "No Email")</MudText>
                </div>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Person" Disabled="true">Profile</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" Disabled="true">System Preferences</MudMenuItem>
                <MudDivider />
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" Href="@RouteConstants.Identity.Logout">Sign Out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </Authorized>
    <NotAuthorized>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@RouteConstants.Identity.Login">Sign In</MudButton>
    </NotAuthorized>
</AuthorizeView>


