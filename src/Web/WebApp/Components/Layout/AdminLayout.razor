@inherits TenantLayoutBase

<TenantWorkspaceShell Breadcrumbs="@_breadcrumbs"
                      UserMenuSubtitle="Admin Workspace"
                      SearchPlaceholder="Global search..."
                      CurrentPart="Admin"
                      Tenant="@Tenant"
                      @bind-DrawerOpen="@_drawerOpen"
                      @bind-SearchText="@_searchText"
                      @bind-IsDarkMode="@_isDarkMode"
                      OnThemeToggle="@(() => _isDarkMode = !_isDarkMode)">
    <NavMenu>
        <AdminNavMenu Tenant="@Tenant" />
    </NavMenu>
    <ChildContent>
        @Body
    </ChildContent>
</TenantWorkspaceShell>
