@inherits TenantLayoutBase

<TenantWorkspaceShell Breadcrumbs="@GetBreadcrumbs()"
                      UserMenuSubtitle="@(TenantName ?? "Workspace")"
                      SearchPlaceholder="Search..."
                      CurrentPart="Workspace"
                      Tenant="@Tenant"
                      @bind-DrawerOpen="@_drawerOpen"
                      @bind-SearchText="@_searchText"
                      @bind-IsDarkMode="@_isDarkMode"
                      OnThemeToggle="@(() => _isDarkMode = !_isDarkMode)">
    <NavMenu>
        <WorkspaceNavMenu Tenant="@Tenant" />
    </NavMenu>
    <ChildContent>
        @Body
    </ChildContent>
</TenantWorkspaceShell>
