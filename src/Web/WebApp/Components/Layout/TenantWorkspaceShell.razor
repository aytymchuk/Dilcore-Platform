@using Dilcore.WebApp.Features.Users
@using Dilcore.WebApp.Components.Themes
@using Dilcore.WebApp.Features.Tenants.Context

<MudThemeProvider @ref="@_themeProvider" @bind-IsDarkMode="@IsDarkMode" Theme="FutureSlateTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<LoadingScreen />

<UserStateProvider>
    <TenantStateProvider SystemName="@Tenant">
        <MudLayout>
            <MudDrawer @bind-Open="@DrawerOpen" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Never" Elevation="0" Class="border-r mud-border-lines-default">
                <MudDrawerHeader Class="px-6 py-4 border-b mud-border-lines-default">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" Class="rounded">
                            <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" />
                        </MudAvatar>
                        <MudText Typo="Typo.h6" Class="font-bold tracking-tight">Dilcore<span style="color: var(--mud-palette-primary);">Platform</span></MudText>
                    </div>
                </MudDrawerHeader>
                <div class="d-flex flex-column flex-nowrap" style="height: calc(100% - 64px); overflow: hidden;">
                    <div class="flex-grow-1 overflow-auto py-2">
                        @NavMenu
                    </div>
                    <MudDivider />
                    <div class="pa-4">
                        <UserMenu InSidebar="true" Subtitle="@UserMenuSubtitle" />
                    </div>
                </div>
            </MudDrawer>
            
            <MudAppBar Elevation="0" Fixed="true" Class="border-b mud-border-lines-default tenant-shell-appbar">
                <MudBreadcrumbs Items="@Breadcrumbs" Class="px-0" />
                <MudSpacer />
                <div class="d-flex align-center gap-4">
                    <MudTextField @bind-Value="@SearchText"
                                  Placeholder="@SearchPlaceholder"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Small"
                                  Class="mt-0 mb-0"
                                  Style="width: 256px;"
                                  Margin="Margin.Dense" />
                    <MudDivider Vertical="true" FlexItem="true" Class="mx-2" Style="height: 16px; align-self: center;" />
                    <TenantPartPicker CurrentPart="@CurrentPart" Tenant="@Tenant" />
                    <MudIconButton Icon="@(IsDarkMode ? Icons.Material.Filled.Brightness7 : Icons.Material.Filled.Brightness4)"
                                   OnClick="@OnThemeToggle"
                                   Color="Color.Inherit" />
                </div>
            </MudAppBar>
            
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.False" Class="shell-content" Style="padding-left: 0; padding-right: 0;">
                    @ChildContent
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </TenantStateProvider>
</UserStateProvider>

@code {
    private MudThemeProvider? _themeProvider;

    [Parameter]
    public RenderFragment? NavMenu { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public List<BreadcrumbItem> Breadcrumbs { get; set; } = new();

    [Parameter]
    public string UserMenuSubtitle { get; set; } = string.Empty;

    [Parameter]
    public string SearchPlaceholder { get; set; } = "Search...";

    [Parameter]
    public string CurrentPart { get; set; } = "Workspace";

    [Parameter]
    public string Tenant { get; set; } = string.Empty;

    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    [Parameter]
    public EventCallback OnThemeToggle { get; set; }

    [Parameter]
    public bool DrawerOpen { get; set; }

    [Parameter]
    public EventCallback<bool> DrawerOpenChanged { get; set; }

    [Parameter]
    public string SearchText { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SearchTextChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeProvider is null)
        {
            return;
        }

        await _themeProvider.WatchSystemDarkModeAsync(async (bool newValue) =>
        {
            IsDarkMode = newValue;

            if (IsDarkModeChanged.HasDelegate)
            {
                await IsDarkModeChanged.InvokeAsync(newValue);
            }
        });
    }

    private async Task HandleThemeToggle()
    {
        IsDarkMode = !IsDarkMode;

        if (IsDarkModeChanged.HasDelegate)
        {
            await IsDarkModeChanged.InvokeAsync(IsDarkMode);
        }

        if (OnThemeToggle.HasDelegate)
        {
            await OnThemeToggle.InvokeAsync();
        }
    }

    private async Task HandleDrawerOpenChanged(bool value)
    {
        DrawerOpen = value;

        if (DrawerOpenChanged.HasDelegate)
        {
            await DrawerOpenChanged.InvokeAsync(value);
        }
    }

    private async Task HandleSearchTextChanged(string value)
    {
        SearchText = value;

        if (SearchTextChanged.HasDelegate)
        {
            await SearchTextChanged.InvokeAsync(value);
        }
    }
}
