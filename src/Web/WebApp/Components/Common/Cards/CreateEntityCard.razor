<div class="flex-column align-center justify-center rounded-xl transition-all cursor-pointer relative create-entity-root" 
     @onclick="HandleClick">
     <div class="card-overlay"></div>
     <div class="z-10 flex-column align-center justify-center w-100 h-100 create-entity-content">
        <div class="d-flex align-center justify-center rounded-circle mb-4 transition-all create-entity-icon">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium" />
        </div>
        <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.875rem; max-width: 180px; margin: 0 auto;">@Subtitle</MudText>
     </div>
</div>
