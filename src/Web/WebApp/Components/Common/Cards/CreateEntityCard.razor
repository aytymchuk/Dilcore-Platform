<div class="flex-column align-center justify-center rounded-xl transition-all cursor-pointer relative" 
     style="display: flex; height: 100%; min-height: 240px; border: 2px dashed var(--mud-palette-lines-default); background-color: transparent; padding: 24px;"
     @onclick="HandleClick">
     <div class="card-overlay hover-mud-border-primary" style="position: absolute; inset: 0; border: 2px dashed transparent; border-radius: 0.75rem; transition: border-color 0.3s;"></div>
     <div class="z-10 flex-column align-center justify-center w-100 h-100" style="display: flex; width: 100%; height: 100%; position: relative; z-index: 10; text-align: center;">
        <div class="d-flex align-center justify-center rounded-circle mb-4 transition-all" style="height: 3rem; width: 3rem; background-color: rgba(255, 255, 255, 0.05); border: 1px solid var(--mud-palette-lines-default); color: var(--mud-palette-text-secondary);">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium" />
        </div>
        <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 600; color: var(--mud-palette-text-primary);">@Title</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-size: 0.875rem; max-width: 180px; margin: 0 auto;">@Subtitle</MudText>
     </div>
</div>
