<div class="entity-card-wrapper" style="height: 100%; width: 100%;">
    <MudCard Elevation="0" Class="entity-card mud-border-lines-default">
        <MudCardContent Class="d-flex flex-column pa-6 flex-grow-1">
            <div class="d-flex align-start justify-space-between mb-8">
               <div class="d-flex align-center justify-center rounded-lg initials-badge">
                   @GetInitials(Title)
               </div>
               @if (!string.IsNullOrEmpty(Role))
               {
                   <span class="chip role-chip">@Role</span>
               }
               @if (!string.IsNullOrEmpty(StatusLabel))
               {
                   <span class="chip status-label">@StatusLabel</span>
               }
            </div>
            
            <div class="mb-6">
                <MudText Typo="@Typo.h6" Class="mb-1 card-title">@Title</MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="@Typo.body2" Color="@Color.Secondary" Class="card-subtitle">@Subtitle</MudText>
                }
                @if (!string.IsNullOrEmpty(Description))
                {
                    <MudText Typo="@Typo.body2" Class="mt-2 card-description">@Description</MudText>
                }
            </div>
            
            <div class="mt-auto pt-3">
                <EntityPrimaryButton 
                    ButtonText="@ButtonText"
                    ButtonIcon="@ButtonIcon"
                    ButtonColor="@ButtonColor"
                    FullWidth="@true"
                    OnClick="@OnClick" />
            </div>
        </MudCardContent>
    </MudCard>
</div>