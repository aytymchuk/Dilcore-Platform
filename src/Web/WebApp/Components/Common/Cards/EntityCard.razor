<div class="entity-card-wrapper" style="height: 100%; width: 100%;">
    <MudCard Elevation="0" Class="entity-card mud-border-lines-default" Style="background-color: var(--mud-palette-surface); border-color: var(--mud-palette-lines-default); height: 100%; display: flex; flex-direction: column;">
        <MudCardContent Class="d-flex flex-column pa-6 flex-grow-1">
            <div class="d-flex align-start justify-space-between mb-8">
               <div class="d-flex align-center justify-center rounded-lg" style="height: 48px; width: 48px; background-color: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); font-size: 1.5rem; font-weight: 700; color: var(--mud-palette-primary);">
                   @GetInitials(Title)
               </div>
               <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; color: var(--mud-palette-text-secondary); padding: 4px 8px; background-color: rgba(255, 255, 255, 0.05); border-radius: 4px; border: 1px solid rgba(255, 255, 255, 0.05);">@Role</span>
            </div>
            
            <div class="mb-6">
                <MudText Typo="@Typo.h6" Class="mb-1" Style="font-weight: 600; font-size: 1.125rem; color: var(--mud-palette-text-primary);">@Title</MudText>
                @if (!string.IsNullOrEmpty(Subtitle))
                {
                    <MudText Typo="@Typo.body2" Color="@Color.Secondary" Style="font-size: 0.875rem;">@Subtitle</MudText>
                }
            </div>
            
            <div class="mt-auto pt-3">
                <EntityPrimaryButton 
                    ButtonText="@ButtonText"
                    ButtonIcon="@ButtonIcon"
                    ButtonColor="@ButtonColor"
                    FullWidth="true"
                    OnClick="@OnClick" />
            </div>
        </MudCardContent>
    </MudCard>
</div>