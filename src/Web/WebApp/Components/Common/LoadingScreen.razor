@namespace Dilcore.WebApp.Components.Common
@using Dilcore.WebApp.Services.Loading

<MudOverlay Visible="@LoadingService.IsLoading" DarkBackground="false" LightBackground="false" Absolute="true" ZIndex="9999" Style="background-color: var(--mud-palette-background);">
    <MudStack AlignItems="AlignItems.Center" Spacing="4">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
        <MudText Typo="Typo.h6" Color="Color.Primary">@LoadingService.CurrentMessage</MudText>
    </MudStack>
</MudOverlay>
